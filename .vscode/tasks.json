{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy to Maven Central",
      "type": "process",
      "command": "rtk",
      "args": [
        "./gradlew",
        "deployMavenCentral",
        "--no-configuration-cache",
        "--no-daemon"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
